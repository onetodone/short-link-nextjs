# Port the dev/start server listens on.
PORT=3001

# Server-only origin of the short-link API.
API_ORIGIN=http://localhost:3000

# Server-only secret (>= 32 chars), the same value as the API's FRONT_PROXY_SECRET.
# When set, /api/v1 requests carry it in x-proxy-secret plus the browser IP in x-client-ip.
# Leave empty to forward requests unchanged.
API_PROXY_SECRET=

# Public base URL this app is served at, used for metadata (metadataBase,
# Open Graph / canonical link resolution).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Server-only support address shown on /link-disabled, on disabled links and in the
# Terms of Use and Privacy Policy. Use the API's SUPPORT_EMAIL. Leave empty to hide it.
SUPPORT_EMAIL=

# Server-only address for abuse reports in the Terms of Use. Empty = SUPPORT_EMAIL.
ABUSE_EMAIL=

# Server-only person or organization that runs this instance, named in the legal texts.
LEGAL_OPERATOR_NAME=

# Server-only governing law in the Terms of Use, e.g. "the Republic of Poland".
# Leave empty to omit the governing-law section.
LEGAL_JURISDICTION=

# Server-only Google Analytics measurement ID (G-...). GA loads only after a visitor
# accepts analytics cookies in the consent banner; empty turns off GA and the banner.
# Read at build time together with the CSP, so set it before `pnpm build`.
GATAG_ID=

# Extra origins allowed in the CSP's connect-src (space-separated), beyond 'self'
# and the Google Analytics origins added when GATAG_ID is set. Read at build time.
# Never add the API's origin: browser requests must go through the /api/v1 proxy.
CSP_CONNECT_SRC_EXTRA=
