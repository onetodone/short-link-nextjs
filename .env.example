# Port the dev/start server listens on.
PORT=3001

# Server-only origin of the short-url API for the Next rewrites() proxy.
API_ORIGIN=http://localhost:3000

# Public base URL this app is served at (metadataBase).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Public redirect origin the API builds `shortUrl` from.
NEXT_PUBLIC_SHORT_URL_BASE=http://localhost:3000

