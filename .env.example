# Port the dev/start server listens on.
PORT=3001

# Server-only origin of the short-url API.
API_ORIGIN=http://localhost:3000

# Public base URL this app is served at, used for metadata (metadataBase,
# Open Graph / canonical link resolution).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Public redirect origin the API builds the absolute `shortUrl` from
# (its own SHORT_URL_BASE).
NEXT_PUBLIC_SHORT_URL_BASE=http://localhost:3000
