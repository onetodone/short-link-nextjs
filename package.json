{
  "name": "short-url-front",
  "version": "0.1.0",
  "description": "Cabinet frontend for the short-url API — create, list, edit, and delete your own short links and see per-link click counts.",
  "private": true,
  "author": "Anton Holubeu (https://github.com/aholu)",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "dotenv -e .env -- next dev -p 3001",
    "build": "next build",
    "start": "dotenv -e .env -- next start -p 3001",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "~6"
  }
}
